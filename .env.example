# Contact form (src/app/api/contact/route.ts) — sends through Resend (https://resend.com).
RESEND_API_KEY=
# Where enquiries go. Defaults to the address in src/content/site.ts.
CONTACT_TO=
# Sender. Must be on a domain verified in Resend; defaults to Resend's onboarding sender,
# which only delivers to the Resend account's own address.
CONTACT_FROM=
